# Copy these values into the Production deployment secrets.
# Never commit the real database password, JWT secret, or R2 credentials.

PORT=8080
APP_ENV=production

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
SUPABASE_JWT_SECRET=your-jwt-secret

# Production can create database save points.
# Restore remains disabled because Production must never be overwritten.
BACKUP_RESTORE_ENABLED=true
BACKUP_RESTORE_TARGET=production
BACKUP_STORAGE=r2

# Production database snapshots use the existing R2 bucket under the backups/ prefix.
# No second image bucket is required.
