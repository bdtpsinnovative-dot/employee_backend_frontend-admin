# NexHR Backend Environment Variables
# Copy this file to .env and fill in real values

# Server
PORT=8080

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
SUPABASE_JWT_SECRET=your-jwt-secret

# Database save points (no separate R2 backup bucket is required)
APP_ENV=development
BACKUP_RESTORE_ENABLED=true
BACKUP_RESTORE_TARGET=local
BACKUP_STORAGE=local
BACKUP_LOCAL_DIR=.data/backups/development

# Production: database save points are enabled, but Restore stays disabled.
# Mount this directory to persistent storage in the deployment environment.
# APP_ENV=production
# BACKUP_RESTORE_ENABLED=false
# BACKUP_STORAGE=r2
# BACKUP_LOCAL_DIR=/app/.data/backups
